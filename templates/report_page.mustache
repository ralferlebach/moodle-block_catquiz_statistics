{{!
    @template block_catquiz_statistics/report_page

    CAT Quiz Statistics report page.
    Used by both report.php (course-level) and adminreport.php (system-wide).
    Data prepared by \block_catquiz_statistics\output\report_page.

    Context variables required for this template:
    * courseid              - integer - Course ID (0 for system-wide).
    * reporturl             - string  - Base URL for filter form action.
    * heading               - string  - Page heading.
    * schemaerror           - bool    - True if local_catquiz is not installed.
    * schemaerrortext       - string  - Schema missing message.
    * filterlabel           - string  - "Filter" label.
    * tabs                  - array   - [{id, label, active, enabled, url}] module tabs.
    * activemoduleid        - string  - Active module ID.
    * issystemwide          - bool    - True for the admin system-wide report.
    * courselabel           - string  - Course selector label (system-wide only).
    * courseoptions         - array   - [{value, label, selected}] course dropdown.
    * instanceslabel        - string  - Instance checkbox list label.
    * instancecheckboxes    - array   - [{value, label, checked}] instance checkboxes.
    * noinstancesmsg        - string  - Message when no instances exist.
    * startdatelabel        - string  - Start date label.
    * enddatelabel          - string  - End date label.
    * applylabel            - string  - Apply button label.
    * startdate             - string  - Current start date value.
    * enddate               - string  - Current end date value.
    * attemptcountlabel     - string  - "Attempts found:" label.
    * attemptcount          - integer - Row count.
    * hasrows               - bool    - True when table has rows.
    * noattemptsmsg         - string  - No-results message.
    * tableheaders          - array   - [{label}] headers.
    * tablerows             - array   - [{cells: [{v}]}] rows.
    * exporturl             - string  - Export form action URL.
    * exportcourseid        - integer - Course ID passed to export (0 = all).
    * appliedinstanceids    - array   - [{value}] hidden inputs for export.
    * formatoptions         - array   - [{value, label, selected}] format dropdown.
    * exportformatlabel     - string  - Format selector label.
    * exportbuttonlabel     - string  - Export button label.

    Example context (json):
    {
        "courseid": 2,
        "reporturl": "/blocks/catquiz_statistics/report.php",
        "heading": "CAT Quiz Statistics",
        "schemaerror": false,
        "schemaerrortext": "",
        "filterlabel": "Filter",
        "tabs": [
            {"id": "results",  "label": "Test Results",  "active": true,  "enabled": true,  "url": "?moduleid=results&courseid=2"},
            {"id": "usage",    "label": "Test Usage",    "active": false, "enabled": true,  "url": "?moduleid=usage&courseid=2"},
            {"id": "progress", "label": "Test Progress", "active": false, "enabled": false, "url": "#"}
        ],
        "activemoduleid": "results",
        "issystemwide": false,
        "courselabel": "Course",
        "courseoptions": [],
        "instanceslabel": "CAT Quiz instances",
        "instancecheckboxes": [{"value": "1", "label": "My Quiz (12)", "checked": false}],
        "noinstancesmsg": "No instances found.",
        "startdatelabel": "From date",
        "enddatelabel": "To date",
        "applylabel": "Apply filter",
        "startdate": "",
        "enddate": "",
        "attemptcountlabel": "Attempts found:",
        "attemptcount": 0,
        "hasrows": false,
        "noattemptsmsg": "No attempts match the current filter.",
        "tableheaders": [{"label": "Name"}],
        "tablerows": [],
        "exporturl": "/blocks/catquiz_statistics/report.php",
        "exportcourseid": 2,
        "appliedinstanceids": [],
        "formatoptions": [{"value": "csv", "label": "CSV", "selected": true}],
        "exportformatlabel": "Export format",
        "exportbuttonlabel": "Export"
    }
}}
<div class="block-catquiz-statistics-report container-fluid mt-3">

    <h2>{{heading}}</h2>

    {{#schemaerror}}
    <div class="alert alert-warning" role="alert">{{schemaerrortext}}</div>
    {{/schemaerror}}

    {{^schemaerror}}

    {{! Module navigation tabs }}
    <ul class="nav nav-tabs mb-3" role="tablist">
        {{#tabs}}
        <li class="nav-item" role="presentation">
            {{#enabled}}
            <a class="nav-link{{#active}} active{{/active}}"
               href="{{{url}}}" role="tab">{{label}}</a>
            {{/enabled}}
            {{^enabled}}
            <a class="nav-link disabled" href="#" tabindex="-1"
               aria-disabled="true">{{label}}</a>
            {{/enabled}}
        </li>
        {{/tabs}}
    </ul>

    {{! Filter form }}
    <div class="card mb-4">
        <div class="card-header">{{filterlabel}}</div>
        <div class="card-body">
            <form method="get" action="{{{reporturl}}}">
                <input type="hidden" name="moduleid" value="{{activemoduleid}}">
                {{^issystemwide}}
                <input type="hidden" name="courseid" value="{{courseid}}">
                {{/issystemwide}}
                <div class="form-row align-items-end">
                    {{#issystemwide}}
                    <div class="form-group col-md-3">
                        <label>{{courselabel}}</label>
                        <select name="courseid" class="form-control form-control-sm">
                            {{#courseoptions}}
                            <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
                            {{/courseoptions}}
                        </select>
                    </div>
                    {{/issystemwide}}
                    <div class="form-group col-md-2">
                        <label>{{startdatelabel}}</label>
                        <input type="date" name="startdate" value="{{startdate}}"
                               class="form-control form-control-sm">
                    </div>
                    <div class="form-group col-md-2">
                        <label>{{enddatelabel}}</label>
                        <input type="date" name="enddate" value="{{enddate}}"
                               class="form-control form-control-sm">
                    </div>
                    <div class="form-group col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm btn-block">
                            {{applylabel}}
                        </button>
                    </div>
                </div>
                {{! Instance multi-select: checkboxes }}
                <div class="form-group mt-2">
                    <label class="d-block font-weight-bold">{{instanceslabel}}</label>
                    {{#instancecheckboxes}}
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"
                               name="instanceids[]" value="{{value}}" id="inst-{{value}}"
                               {{#checked}}checked{{/checked}}>
                        <label class="form-check-label" for="inst-{{value}}">{{label}}</label>
                    </div>
                    {{/instancecheckboxes}}
                    {{^instancecheckboxes}}
                    <span class="text-muted">{{noinstancesmsg}}</span>
                    {{/instancecheckboxes}}
                </div>
            </form>
        </div>
    </div>

    {{! Result count + export form }}
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted">{{attemptcountlabel}} <strong>{{attemptcount}}</strong></span>
        <form method="get" action="{{{exporturl}}}" class="form-inline">
            <input type="hidden" name="moduleid" value="{{activemoduleid}}">
            <input type="hidden" name="courseid" value="{{exportcourseid}}">
            {{#appliedinstanceids}}
            <input type="hidden" name="instanceids[]" value="{{value}}">
            {{/appliedinstanceids}}
            <input type="hidden" name="startdate" value="{{startdate}}">
            <input type="hidden" name="enddate" value="{{enddate}}">
            <label class="mr-2 mb-0">{{exportformatlabel}}</label>
            <select name="export" class="form-control form-control-sm mr-2">
                {{#formatoptions}}
                <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
                {{/formatoptions}}
            </select>
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                {{exportbuttonlabel}}
            </button>
        </form>
    </div>

    {{! Attempts table }}
    {{#hasrows}}
    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover">
            <thead class="thead-light">
                <tr>
                    {{#tableheaders}}<th scope="col">{{label}}</th>{{/tableheaders}}
                </tr>
            </thead>
            <tbody>
                {{#tablerows}}
                <tr>
                    {{#cells}}<td>{{v}}</td>{{/cells}}
                </tr>
                {{/tablerows}}
            </tbody>
        </table>
    </div>
    {{/hasrows}}
    {{^hasrows}}
    <div class="alert alert-info mt-3" role="alert">{{noattemptsmsg}}</div>
    {{/hasrows}}

    {{/schemaerror}}

</div>
